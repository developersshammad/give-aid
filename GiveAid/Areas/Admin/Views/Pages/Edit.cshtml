@model ContentPage
@{ ViewData["Title"] = "Edit: " + Model.Title; }

<div class="row g-4">
    <div class="col-xl-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Title" class="form-label">@(Model.Slug == "home" ? "Hero headline" : "Page title")</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Subtitle" class="form-label">@(Model.Slug == "home" ? "Hero text" : "Subtitle")</label>
                <input asp-for="Subtitle" class="form-control" />
                <span asp-validation-for="Subtitle" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Body" class="form-label">Page text</label>
                <textarea asp-for="Body" class="form-control editor" rows="18"></textarea>
                <span asp-validation-for="Body" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-ga">Save page</button>
                <a asp-action="Index" class="btn btn-outline-ga">Cancel</a>
            </div>
        </form>
    </div>
    <div class="col-xl-4">
        <div class="markup-help">
            <h2 class="h6">How to format the text</h2>
            <p class="mb-2">Leave an empty line to start a new paragraph.</p>
            <p class="mb-2"><code>## Heading</code> makes a sub-heading.</p>
            <p class="mb-2"><code>- item</code> makes a bullet point.</p>
            <p class="mb-0">HTML tags are shown as plain text, for safety.</p>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
