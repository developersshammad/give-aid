@model List<ContentPage>
@{ ViewData["Title"] = "Pages & content"; }

<p class="text-secondary">Edit the text of the home intro, all About Us sub pages, the Help Centre and Contact Us.</p>
<div class="table-wrap">
    <table class="table table-ga">
        <thead><tr><th>Section</th><th>Page</th><th>Address</th><th>Last updated</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in Model)
            {
                string url = p.Section switch
                {
                    "About" => "/About/" + p.Slug,
                    "Help" => "/Help",
                    "Contact" => "/Home/Contact",
                    _ => "/"
                };
                <tr>
                    <td><span class="tag">@p.Section</span></td>
                    <td><b>@p.Title</b></td>
                    <td class="small"><a href="@url" target="_blank">@url</a></td>
                    <td class="small">@p.UpdatedAt.ToString("dd MMM yyyy, HH:mm")</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-ga" asp-action="Edit" asp-route-id="@p.Id"><i class="bi bi-pencil me-1"></i>Edit</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
