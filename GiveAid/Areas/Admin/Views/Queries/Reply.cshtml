@model ReplyViewModel
@{ ViewData["Title"] = "Reply to query"; var q = Model.Query!; }

<div class="panel mb-3" style="max-width:48rem">
    <b>@q.Subject</b>
    <div class="small text-secondary">@q.Name (@q.Email), @q.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
    <p class="mb-0 mt-2">@q.Message</p>
</div>
<form asp-action="Reply" method="post" class="panel" style="max-width:48rem" novalidate>
    <input type="hidden" asp-for="Id" />
    <label asp-for="Reply" class="form-label">Your reply</label>
    <textarea asp-for="Reply" class="form-control" rows="7"></textarea>
    <span asp-validation-for="Reply" class="text-danger"></span>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-ga"><i class="bi bi-send me-1"></i>Send reply</button>
        <a asp-action="Index" class="btn btn-outline-ga">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
