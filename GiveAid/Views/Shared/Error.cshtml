@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="container section text-center">
    <div class="big-code">Oops</div>
    <h1 class="h2 mt-3">Something went wrong.</h1>
    <p class="text-secondary">Please try again. If the problem continues, contact us through the Help Centre.</p>
    @if (Model?.ShowRequestId == true) { <p class="small text-secondary">Request ID: <code>@Model.RequestId</code></p> }
    <a class="btn btn-ga" href="/">Back to home</a>
</div>
