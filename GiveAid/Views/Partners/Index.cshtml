@model List<Partner>
@{ ViewData["Title"] = "Our partners"; }
<partial name="_PageHead" model="@(("Our partners", (string?)"Give-AID was established with the help of these companies. They cover our running costs and support programmes directly."))" />

<section class="section">
    <div class="container">
        <div class="logo-strip mb-5">
            @foreach (var p in Model)
            {
                <div><img src="@p.LogoPath" alt="@p.Name logo" loading="lazy" /></div>
            }
        </div>
        @foreach (var group in Model.GroupBy(p => p.PartnerType))
        {
            <h2 class="h3 mt-4">@group.Key partners</h2>
            @foreach (var p in group)
            {
                <div class="partner-row">
                    <img src="@p.LogoPath" alt="" loading="lazy" />
                    <div>
                        <h3 class="h4 mb-1">@p.Name</h3>
                        <p class="mb-1 text-secondary">@p.Description</p>
                        @if (!string.IsNullOrEmpty(p.Website))
                        {
                            <a href="@p.Website" target="_blank" rel="noopener">Visit website <i class="bi bi-box-arrow-up-right small"></i></a>
                        }
                    </div>
                </div>
            }
        }
        <div class="panel mt-5 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h4 mb-1">Want your company to partner with us?</h2>
                <p class="text-secondary mb-0">We offer employee giving, matched donations and volunteering days.</p>
            </div>
            <a class="btn btn-ga" asp-controller="Home" asp-action="Contact">Talk to us</a>
        </div>
    </div>
</section>
