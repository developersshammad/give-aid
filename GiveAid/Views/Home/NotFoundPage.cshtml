@{ ViewData["Title"] = "Page not found"; }
<div class="container section text-center">
    <div class="big-code">404</div>
    <h1 class="h2 mt-3">We couldn't find that page.</h1>
    <p class="text-secondary">It may have been moved or deleted.</p>
    <div class="d-flex gap-2 justify-content-center">
        <a class="btn btn-ga" href="/">Go to home</a>
        <a class="btn btn-outline-ga" asp-controller="Donate" asp-action="Index">Donate</a>
    </div>
</div>
