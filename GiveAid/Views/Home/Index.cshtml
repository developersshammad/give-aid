@model HomeViewModel
@{
    ViewData["Title"] = "";
    var presets = new[] { 1000, 2500, 5000, 10000 };
}

<!-- ===== Hero: WebGL scene (js/hero3d.js) + headline + quick donation panel ===== -->
<section class="hero">
    <div class="hero-canvas" data-hero3d aria-hidden="true"></div>
    <div class="container">
        <div class="row">
            <div class="col-lg-7 hero-copy">
                <div class="hero-badge"><span class="pulse-dot"></span><b>Live</b>@Model.DonorCount people have given so far</div>
                <h1 class="type-3d">@(Model.Intro?.Title ?? "Small gifts, pooled together, change whole neighbourhoods.")</h1>
                <p class="lead">@Model.Intro?.Subtitle</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-donate btn-lg" asp-controller="Donate" asp-action="Index"><i class="bi bi-heart-fill me-1"></i>Donate now</a>
                    <a class="btn btn-outline-light-ga btn-lg" asp-controller="Programmes" asp-action="Index">See upcoming programmes</a>
                </div>
            </div>
        </div>

        <!-- Quick donation bar -->
        <form class="quick-give quick-bar" method="get" asp-controller="Donate" asp-action="Index" data-tilt="3">
            <h2>Give in under a minute</h2>
            <div class="qb-grid">
                <div>
                    <label class="form-label" for="qgCause">I want to help</label>
                    <select class="form-select" id="qgCause" name="causeId">
                        @foreach (var c in Model.Causes)
                        {
                            <option value="@c.Cause.Id">@c.Cause.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <span class="form-label d-block" id="qgAmountLabel">Amount (Rs)</span>
                    <div class="amount-chips" role="radiogroup" aria-labelledby="qgAmountLabel">
                        @for (int i = 0; i < presets.Length; i++)
                        {
                            <input type="radio" name="amount" id="qa@(i)" value="@presets[i]" checked="@(i == 2)" />
                            <label for="qa@(i)">@presets[i].ToString("#,##0")</label>
                        }
                    </div>
                </div>
                <div class="d-flex flex-column justify-content-end">
                    <button type="submit" class="btn btn-ga btn-lg">Continue to payment</button>
                </div>
            </div>
            <p class="small text-secondary mt-2 mb-0"><i class="bi bi-shield-check me-1"></i>Demo payment. Your card number is never stored.</p>
        </form>

        <div class="hero-ledger">
            <div><strong data-count="@Model.TotalRaised.ToString("0")" data-prefix="Rs ">@ContentFormatter.Rupees(Model.TotalRaised)</strong><span>raised by donors</span></div>
            <div><strong data-count="@Model.DonorCount">@Model.DonorCount.ToString("#,##0")</strong><span>people have given</span></div>
            <div><strong data-count="@Model.NgoCount">@Model.NgoCount</strong><span>NGOs working together</span></div>
            <div><strong data-count="@Model.ProgrammeCount">@Model.ProgrammeCount</strong><span>programmes run</span></div>
        </div>
    </div>
</section>

<!-- ===== Causes ===== -->
<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <h2>Choose where your money goes</h2>
                <p>Every donation is tied to one cause and spent only on it.</p>
            </div>
            <a class="btn btn-outline-ga" asp-controller="Donate" asp-action="Index">All causes</a>
        </div>
        <div class="cause-grid">
            @foreach (var c in Model.Causes)
            {
                <div class="cause-tile">
                    <span class="cause-icon"><i class="bi bi-@c.Cause.Icon"></i></span>
                    <h3>@c.Cause.Name</h3>
                    <p>@c.Cause.Description</p>
                    <partial name="_RaiseBar" model="c" />
                    <a class="cause-link" asp-controller="Donate" asp-action="Index" asp-route-causeId="@c.Cause.Id">Give to @c.Cause.Name.ToLower() <span class="visually-hidden">cause</span></a>
                </div>
            }
        </div>
    </div>
</section>

<!-- ===== Upcoming programmes + latest gifts ===== -->
<section class="section section-tint">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-9">
                <div class="section-head">
                    <div>
                        <h2>Coming up</h2>
                        <p>Join as a volunteer, participant or sponsor.</p>
                    </div>
                    <a asp-controller="Programmes" asp-action="Index" class="fw-semibold">All programmes</a>
                </div>
                @if (Model.Upcoming.Count == 0)
                {
                    <p class="text-secondary">New programmes will be announced soon.</p>
                }
                <div class="row g-3">
                    @foreach (var p in Model.Upcoming)
                    {
                        <div class="col-md-4"><partial name="_ProgrammeCard" model="p" /></div>
                    }
                </div>
            </div>
            <div class="col-lg-3">
                <div class="section-head"><h2>Latest gifts</h2></div>
                <ul class="gift-list">
                    @foreach (var d in Model.RecentDonations)
                    {
                        <li>
                            <div>
                                <div class="who">@(d.IsAnonymous ? "A kind donor" : d.DonorName.Split(' ')[0])</div>
                                <div class="what">for @d.Cause?.Name, @d.DonatedAt.ToString("dd MMM")</div>
                            </div>
                            <div class="amt">@ContentFormatter.Rupees(d.Amount)</div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- ===== Gallery preview ===== -->
@if (Model.Gallery.Count > 0)
{
    <section class="section">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2>From the field</h2>
                    <p>Photos from programmes your donations paid for.</p>
                </div>
                <a asp-controller="Gallery" asp-action="Index" class="fw-semibold">Open gallery</a>
            </div>
            <div class="ring-stage" data-ring role="region" aria-label="Photo carousel. Drag, or use the left and right arrow keys, to turn it.">
                <div class="ring">
                    @foreach (var g in Model.Gallery)
                    {
                        <figure>
                            <img src="@g.ImagePath" alt="@g.Title" loading="lazy" draggable="false" />
                            <figcaption>@g.Title</figcaption>
                        </figure>
                    }
                </div>
            </div>
        </div>
    </section>
}

<!-- ===== Partners ===== -->
<section class="section section-tint">
    <div class="container">
        <div class="section-head">
            <div>
                <h2>Companies that made Give-AID possible</h2>
                <p>Our partners pay the running costs, so your donation goes fully to programmes.</p>
            </div>
            <a asp-controller="Partners" asp-action="Index" class="fw-semibold">Meet our partners</a>
        </div>
        <div class="marquee">
            <div class="marquee-track">
                @foreach (var p in Model.Partners)
                {
                    <a asp-controller="Partners" asp-action="Index"><img src="@p.LogoPath" alt="@p.Name" loading="lazy" /></a>
                }
            </div>
        </div>
    </div>
</section>

<!-- ===== Join band ===== -->
<section class="join-band">
    <div class="container">
        <div class="d-flex align-items-center gap-4">
            <div class="cube-wrap" aria-hidden="true">
                <div class="cube">
                    <span><i class="bi bi-heart-fill"></i></span><span><i class="bi bi-book"></i></span><span><i class="bi bi-house-heart"></i></span>
                    <span><i class="bi bi-universal-access"></i></span><span><i class="bi bi-balloon-heart"></i></span><span><i class="bi bi-rocket-takeoff"></i></span>
                </div>
            </div>
            <h2>Bring a friend along. Two people giving is twice the help.</h2>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (User.GetMemberId() != null)
            {
                <a class="btn btn-ga btn-lg" asp-controller="Invite" asp-action="Index">Invite friends</a>
            }
            else
            {
                <a class="btn btn-ga btn-lg" asp-controller="Account" asp-action="Register">Create a free account</a>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/dist/hero3d.js" asp-append-version="true"></script>
}
