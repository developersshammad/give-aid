@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; bool emailWorks = ViewBag.EmailWorks is true; }
<div class="section px-3">
    <form asp-action="ForgotPassword" method="post" class="panel mx-auto otp-panel" style="max-width:28rem" novalidate>
        <div class="otp-icon" aria-hidden="true"><i class="bi bi-key"></i></div>
        <h1 class="h3 mb-1">Forgot your password?</h1>
        <p class="text-secondary">Enter the e-mail address of your account. We will send you a 6-digit code to set a new password.</p>
        @if (!emailWorks)
        {
            <div class="otp-demo" role="status"><i class="bi bi-info-circle"></i>
                <div>E-mail sending is not set up on this website yet, so reset codes cannot be sent. Please raise a query in the <a asp-controller="Help" asp-action="Index">Help Centre</a>.</div></div>
        }
        <partial name="_Alerts" />
        <div asp-validation-summary="ModelOnly" class="alert alert-ga-error py-2" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-ga w-100"><i class="bi bi-send me-1"></i>Send code</button>
        <p class="small text-secondary mt-3 mb-0"><a asp-action="Login">Back to log in</a></p>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
