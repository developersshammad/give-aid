@model VerifyEmailViewModel
@{
    ViewData["Title"] = "Verify your e-mail";
    int wait = ViewBag.Wait is int w ? w : 0;
}
<div class="auth-wrap">
    <div class="auth-side d-none d-lg-block">
        <h1 class="h2 mb-3">One last step</h1>
        <p>We check that the e-mail address is really yours, so receipts and replies reach you safely.</p>
        <ul>
            <li><i class="bi bi-envelope-check"></i>Look for an e-mail from Give-AID</li>
            <li><i class="bi bi-123"></i>Type the 6-digit code</li>
            <li><i class="bi bi-clock"></i>The code works for 10 minutes</li>
            <li><i class="bi bi-shield-lock"></i>We never ask for your password by e-mail</li>
        </ul>
    </div>
    <div class="section px-3">
        <form asp-action="VerifyEmail" method="post" class="panel mx-auto otp-panel" style="max-width:28rem" novalidate>
            <div class="otp-icon" aria-hidden="true"><i class="bi bi-envelope-paper-heart"></i></div>
            <h1 class="h3 mb-1">Verify your e-mail</h1>
            <p class="text-secondary">Enter the 6-digit code we sent to <b class="text-break">@Model.Email</b>.</p>

            <partial name="_Alerts" />
            <div asp-validation-summary="ModelOnly" class="alert alert-ga-error py-2" role="alert"></div>
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="Remember" />
            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control otp-input" inputmode="numeric" autocomplete="one-time-code" maxlength="7" placeholder="••••••" autofocus />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-ga w-100"><i class="bi bi-check2-circle me-1"></i>Verify e-mail</button>
        </form>

        <form asp-action="ResendCode" method="post" class="mx-auto text-center mt-3" style="max-width:28rem">
            <input type="hidden" name="email" value="@Model.Email" />
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <input type="hidden" name="remember" value="@Model.Remember.ToString().ToLower()" />
            <span class="text-secondary small">Didn't get it? Check the spam folder, or</span>
            <button type="submit" class="btn btn-link btn-sm p-0 align-baseline" id="resendBtn" data-wait="@wait" @(wait > 0 ? "disabled" : "")>
                send a new code<span id="resendWait">@(wait > 0 ? $" in {wait}s" : "")</span>
            </button>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // keep only digits, show them as "123 456"
            var box = document.getElementById("Code");
            if (box) box.addEventListener("input", function () {
                var d = box.value.replace(/\D/g, "").slice(0, 6);
                box.value = d.length > 3 ? d.slice(0, 3) + " " + d.slice(3) : d;
            });
            // countdown before a new code can be sent
            var b = document.getElementById("resendBtn"), out = document.getElementById("resendWait");
            var left = b ? parseInt(b.getAttribute("data-wait") || "0", 10) : 0;
            if (left > 0) {
                var t = setInterval(function () {
                    left--;
                    if (left <= 0) { clearInterval(t); b.disabled = false; out.textContent = ""; }
                    else out.textContent = " in " + left + "s";
                }, 1000);
            }
        })();
    </script>
}
