@model ResetPasswordViewModel
@{ ViewData["Title"] = "Set a new password"; }
<div class="section px-3">
    <form asp-action="ResetPassword" method="post" class="panel mx-auto otp-panel" style="max-width:28rem" novalidate>
        <div class="otp-icon" aria-hidden="true"><i class="bi bi-shield-lock"></i></div>
        <h1 class="h3 mb-1">Set a new password</h1>
        <p class="text-secondary">Type the code from the e-mail sent to <b class="text-break">@Model.Email</b> and choose a new password.</p>
        <partial name="_Alerts" />
        <div asp-validation-summary="ModelOnly" class="alert alert-ga-error py-2" role="alert"></div>
        <input type="hidden" asp-for="Email" />
        <div class="mb-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control otp-input" inputmode="numeric" autocomplete="one-time-code" maxlength="7" placeholder="••••••" autofocus />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
            <div class="form-text">At least 8 characters, with letters and a number.</div>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-ga w-100">Change password</button>
        <p class="small text-secondary mt-3 mb-0">No code? <a asp-action="ForgotPassword">Send a new one</a></p>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var box = document.getElementById("Code");
            if (box) box.addEventListener("input", function () {
                var d = box.value.replace(/\D/g, "").slice(0, 6);
                box.value = d.length > 3 ? d.slice(0, 3) + " " + d.slice(3) : d;
            });
        })();
    </script>
}
